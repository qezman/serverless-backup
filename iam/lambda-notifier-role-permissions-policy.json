{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowLambdaLogging",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-1:203637463799:log-group:/aws/lambda/backup-notifier:*"
    },
    {
      "Sid": "AllowReadStatusMarker",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::serverless-backup-project-203637463799/status/*"
    },
    {
      "Sid": "AllowReadSlackWebhookSecret",
      "Effect": "Allow",
      "Action": ["secretsmanager:GetSecretValue"],
      "Resource": "arn:aws:secretsmanager:us-east-1:203637463799:secret:backup-notifier/slack-webhook-*"
    }
  ]
}
